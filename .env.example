# Supabase Configuration
# احصل على هذه القيم من: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# مفتاح الخدمة (service_role) - مطلوب للعمليات الخادم-جانب (لا تشاركه أبداً!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional direct database connection for migration script fallback (server-side only)
SUPABASE_DB_URL=

# Admin Dashboard Configuration
# كلمة مرور قوية للوحة التحكم (غيّرها إلى كلمة مرور آمنة!)
ADMIN_PASSWORD=your_secure_admin_password_here

# Robot Video URL (Supabase Storage signed URL)
NEXT_PUBLIC_ROBOT_VIDEO_URL=your_robot_video_signed_url_here

# Google Analytics 4
# احصل على معرف القياس من: https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel / Conversions API
# احصل على التوكن من: Meta Events Manager → Settings → Generate Access Token
META_CONVERSIONS_TOKEN=your_meta_conversions_api_token_here

# Kashier Payment Gateway
# احصل على هذه القيم من لوحة تحكم كاشير: https://merchant.kashier.io
KASHIER_API_KEY=your_kashier_api_key_here
KASHIER_SECRET_KEY=your_kashier_secret_key_here
KASHIER_MERCHANT_ID=MID-XXXX-XXXX
NEXT_PUBLIC_KASHIER_MODE=test
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Chat Assistant API Keys
# احصل على المفاتيح من مواقع كل مزود
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
XAI_API_KEY=your_xai_api_key_here

# Firebase Authentication Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here

# Firebase Admin SDK (Server-side only - Keep secure!)
FIREBASE_ADMIN_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"..."}'

# Email (Resend) — https://resend.com
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=YourApp <noreply@yourdomain.com>

# Cron Secret (for scheduled tasks authentication)
CRON_SECRET=your_random_cron_secret_here

# WhatsApp Support (رقم بصيغة دولية بدون + مثل 201XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=201XXXXXXXXX

# ملاحظات مهمة:
# 1. انسخ هذا الملف إلى .env.local
# 2. لا تشارك ملف .env.local أبداً
# 3. تأكد من إضافة .env.local لـ .gitignore
# 4. استخدم كلمات مرور قوية تحتوي على أحرف كبيرة وصغيرة وأرقام ورموز
